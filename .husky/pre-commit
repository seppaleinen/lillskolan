#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Map paths to package names
path_to_pkg() {
  case "$1" in
    apps/hub*) echo "lillskolan-hub" ;;
    apps/lessons/phonics-cvc*) echo "phonics-cvc" ;;
    packages/lesson-sdk*) echo "@lillskolan/lesson-sdk" ;;
    *) echo "" ;;
  esac
}

# Get changed packages from staged files
# Use awk to get first 3 path components
CHANGED_PATHS=$(git diff --cached --name-only | grep -E '^(apps/|packages/)' | awk -F'/' '{print $1"/"$2"/"$3}' | sort -u)

if [ -n "$CHANGED_PATHS" ]; then
  echo "Running typecheck + tests on changed packages..."
  
  CHANGED_PKGS=""
  for path in $CHANGED_PATHS; do
    pkg=$(path_to_pkg "$path")
    if [ -n "$pkg" ]; then
      CHANGED_PKGS="$CHANGED_PKGS $pkg"
    fi
  done
  
  # Deduplicate
  CHANGED_PKGS=$(echo $CHANGED_PKGS | tr ' ' '\n' | sort -u | tr '\n' ' ')
  
  if [ -n "$CHANGED_PKGS" ]; then
    for PKG in $CHANGED_PKGS; do
      echo "  → $PKG"
      pnpm --filter "$PKG" typecheck && pnpm --filter "$PKG" test || exit 1
    done
  fi
  
  echo "✅ Pre-commit checks passed"
fi

# ── LFS binary gate ───────────────────────────────────────────────────────
# Reject any staged file >10 MB that is not LFS-tracked.
# See docs/adr/0009-binary-asset-policy.md
LARGE_FILE_LIMIT=10485760  # 10 MB

LARGE_STAGED=$(git diff --cached --name-only --diff-filter=ACM \
  | while read -r f; do
      if [ -f "$f" ]; then
        sz=$(stat -f%z "$f" 2>/dev/null || stat -c%s "$f" 2>/dev/null)
        if [ "$sz" -gt "$LARGE_FILE_LIMIT" ] 2>/dev/null; then
          if ! git check-attr -a "$f" 2>/dev/null | grep -q "filter: lfs"; then
            echo "$f ($sz bytes)"
          fi
        fi
      fi
    done
)

if [ -n "$LARGE_STAGED" ]; then
  echo ""
  echo "❌ REJECTED: staged files >10 MB without Git LFS tracking:"
  echo "$LARGE_STAGED"
  echo ""
  echo "Add the file to LFS: git lfs track '<pattern>'"
  echo "Or see docs/adr/0009-binary-asset-policy.md"
  exit 1
fi

echo "✅ LFS binary gate passed"