{
  "name": "lillskolan",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n hub,lesson -c cyan,magenta --success first \"pnpm --filter lillskolan-hub dev\" \"pnpm --filter phonics-cvc dev\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm -r typecheck && pnpm test && pnpm build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.7.0",
    "concurrently": "^9.0.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
