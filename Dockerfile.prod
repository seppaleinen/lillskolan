# Build stage
FROM node:20-alpine AS build

WORKDIR /app

# Enable corepack for pnpm
RUN corepack enable

# Build arguments for environment variables
ARG VITE_HUB_ORIGIN
ARG VITE_LESSON_ORIGIN
ARG VITE_LESSON_ENTRY

# Copy package files first for caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/hub/package.json ./apps/hub/
COPY apps/lessons/phonics-cvc/package.json ./apps/lessons/phonics-cvc/
COPY packages/lesson-sdk/package.json ./packages/lesson-sdk/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code
COPY . .

# Write per-app .env files from build args
RUN echo "VITE_LESSON_ORIGIN=${VITE_LESSON_ORIGIN}" > apps/hub/.env && \
    echo "VITE_HUB_ORIGIN=${VITE_HUB_ORIGIN}" > apps/lessons/phonics-cvc/.env && \
    echo "VITE_LESSON_ENTRY=${VITE_LESSON_ENTRY}" >> apps/hub/.env

# Build all apps
RUN pnpm build

# Runtime stage
FROM nginx:alpine

# Copy built assets from build stage
COPY --from=build /app/apps/hub/dist /usr/share/nginx/html/
COPY --from=build /app/apps/lessons/phonics-cvc/dist /usr/share/nginx/html/lesson/

# Copy nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]